# Database
DATABASE_URL=postgresql://ennitant:ennitant@localhost:5432/ennitant?schema=public
DIRECT_URL=postgresql://ennitant:ennitant@localhost:5432/ennitant?schema=public

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

OTP_DEV_MODE=true

# API
API_PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# n8n (internal automation — never expose to frontend)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_SECRET=change-me-n8n-webhook-secret
N8N_ORDER_WEBHOOK_PATH=/webhook/ennitant-order

# Meta WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=change-me-meta-verify-token
META_GRAPH_API_VERSION=v21.0

# Optional defaults for local WhatsApp testing (prefer per-business tokens in DB)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Email (password reset / verification — optional in local dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ennitant.com

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Frontend (Vite)
VITE_API_URL=http://localhost:3001/api
