generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DISPATCHED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum NotificationType {
  NEW_ORDER
  ORDER_CONFIRMED
  ORDER_CANCELLED
  AUTOMATION_FAILED
  WHATSAPP_ISSUE
  SYSTEM
  CAMPAIGN_PUBLISHED
  POST_FAILED
  SOCIAL_EXPIRED
  MEDIA_FAILED
}

enum WorkflowStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  TIMEOUT
}

model User {
  id                  String     @id @default(cuid())
  phoneNumber         String     @unique
  email               String?    @unique
  passwordHash        String
  firstName           String?
  lastName            String?
  role                UserRole   @default(OWNER)
  isVerified          Boolean    @default(false)
  otpHash             String?
  otpExpiresAt        DateTime?
  otpAttempts         Int        @default(0)
  emailVerified       Boolean    @default(false)
  businessId          String
  business            Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  auditLogs           AuditLog[]
  campaignsCreated    Campaign[]
  campaignMedia       CampaignMedia[]

  @@index([businessId])
}

model Business {
  id                  String              @id @default(cuid())
  name                String
  companyName         String?
  slug                String              @unique
  ownerName           String?
  email               String?
  industry            String?
  timezone            String              @default("UTC")
  currency            String              @default("PKR")
  phone               String?
  whatsappNumber      String?
  whatsappVerified    Boolean             @default(false)
  metaPhoneNumberId   String?             @unique
  wabaId              String?
  vendorPortalEnabled Boolean             @default(true)
  address             String?
  onboardingCompleted Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  users               User[]
  products            Product[]
  orders              Order[]
  customers           Customer[]
  vendors             Vendor[]
  whatsappAccount     WhatsAppAccount?
  integrations        Integration[]
  notifications       Notification[]
  workflowExecutions  WorkflowExecution[]
  auditLogs           AuditLog[]
  whatsappMessages    WhatsAppMessage[]
  campaigns           Campaign[]
  campaignMedia       CampaignMedia[]
  socialAccounts      SocialAccount[]
  campaignPosts       CampaignPost[]
}

model Product {
  id          String      @id @default(cuid())
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sku         String?
  price       Decimal     @db.Decimal(12, 2)
  currency    String      @default("PKR")
  stock       Int         @default(0)
  imageUrl    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@unique([businessId, sku])
  @@index([businessId])
}

model Customer {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String?
  phone      String
  email      String?
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  orders     Order[]
  messages   WhatsAppMessage[]

  @@unique([businessId, phone])
  @@index([businessId])
}

model Order {
  id            String               @id @default(cuid())
  businessId    String
  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status        OrderStatus          @default(PENDING)
  orderNumber   String
  totalAmount   Decimal              @db.Decimal(12, 2)
  currency      String               @default("PKR")
  notes         String?
  deliveryAddress String?
  source        String               @default("whatsapp")
  whatsappMsgId String?
  confirmedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([businessId, status])
  @@index([customerId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name       String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  totalPrice Decimal  @db.Decimal(12, 2)
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  changedBy String?
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Vendor {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  phoneNumber String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  accessTokens VendorAccess[]

  @@index([businessId])
}

model VendorAccess {
  id             String    @id @default(cuid())
  vendorId       String
  vendor         Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// SHA-256 hash of the bearer token (lookup key)
  tokenHash      String    @unique
  /// Encrypted plaintext token so dashboard can re-display the share link
  tokenEncrypted String
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([vendorId])
}

model WhatsAppAccount {
  id                   String                   @id @default(cuid())
  businessId           String                   @unique
  business             Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Meta WhatsApp Cloud API phone_number_id (unique across platform)
  phoneNumberId        String                   @unique
  wabaId               String?
  displayPhoneNumber   String?
  accessTokenEncrypted String
  status               WhatsAppConnectionStatus @default(DISCONNECTED)
  lastError            String?
  lastWebhookAt        DateTime?
  connectedAt          DateTime?
  tokenExpiresAt       DateTime?
  connectedByUserId    String?
  embeddedSignupAt     DateTime?
  connectionMetadata   Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
}

model WhatsAppMessage {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  waMessageId String?          @unique
  direction   MessageDirection
  fromPhone   String
  toPhone     String?
  body        String
  rawPayload  Json?
  createdAt   DateTime         @default(now())

  @@index([businessId])
  @@index([customerId])
}

model Integration {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String
  name       String
  config     Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
}

model Notification {
  id         String           @id @default(cuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  metadata   Json?
  createdAt  DateTime         @default(now())

  @@index([businessId, isRead])
}

model WorkflowExecution {
  id           String         @id @default(cuid())
  businessId   String
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workflowName String
  status       WorkflowStatus @default(PENDING)
  input        Json?
  output       Json?
  error        String?
  attempts     Int            @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([businessId])
}

model AuditLog {
  id         String    @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([businessId])
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
  LINKEDIN
}

enum SocialConnectionStatus {
  DISCONNECTED
  CONNECTED
  EXPIRED
  ERROR
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  SCHEDULED
  COMPLETED
  ARCHIVED
}

enum CampaignPostingType {
  NOW
  SCHEDULE
  DRAFT
}

enum MediaUploadStatus {
  UPLOADING
  READY
  FAILED
}

enum PostStatus {
  DRAFT
  PENDING
  PROCESSING
  SCHEDULED
  PUBLISHED
  FAILED
}

enum PublishingJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  RETRYING
}

model Campaign {
  id              String              @id @default(cuid())
  businessId      String
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  name            String
  description     String?
  status          CampaignStatus      @default(DRAFT)
  postingType     CampaignPostingType @default(DRAFT)
  scheduledAt     DateTime?
  timezone        String              @default("UTC")
  platforms       SocialPlatform[]
  aiContent       Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  media           CampaignMedia[]
  posts           CampaignPost[]

  @@index([businessId])
  @@index([businessId, status])
}

model CampaignMedia {
  id               String            @id @default(cuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaignId       String?
  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  uploadedByUserId String?
  uploadedBy       User?             @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  filename         String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  publicUrl        String?
  thumbnailKey     String?
  durationSeconds  Float?
  status           MediaUploadStatus @default(READY)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  posts            CampaignPost[]

  @@index([businessId])
  @@index([campaignId])
}

model SocialAccount {
  id                    String                 @id @default(cuid())
  businessId            String
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform              SocialPlatform
  accountId             String
  accountName           String
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  scopes                String?
  metadata              Json?
  status                SocialConnectionStatus @default(CONNECTED)
  lastError             String?
  lastTestedAt          DateTime?
  connectedAt           DateTime               @default(now())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  posts                 CampaignPost[]

  @@unique([businessId, platform, accountId])
  @@index([businessId])
}

model CampaignPost {
  id              String          @id @default(cuid())
  businessId      String
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaignId      String
  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  socialAccountId String?
  socialAccount   SocialAccount?  @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  mediaId         String?
  media           CampaignMedia?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  platform        SocialPlatform
  caption         String          @default("")
  hashtags        String          @default("")
  scheduledAt     DateTime?
  publishedAt     DateTime?
  status          PostStatus      @default(DRAFT)
  externalPostId  String?
  errorMessage    String?
  idempotencyKey  String          @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  jobs            PublishingJob[]

  @@index([businessId])
  @@index([campaignId])
  @@index([status])
}

model PublishingJob {
  id          String              @id @default(cuid())
  postId      String
  post        CampaignPost        @relation(fields: [postId], references: [id], onDelete: Cascade)
  status      PublishingJobStatus @default(PENDING)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)
  nextRunAt   DateTime            @default(now())
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, nextRunAt])
  @@index([postId])
}
