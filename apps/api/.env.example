# Database
DATABASE_URL=postgresql://ennitant:ennitant@localhost:5432/ennitant?schema=public
# Neon: use non-pooling host for migrations
DIRECT_URL=postgresql://ennitant:ennitant@localhost:5432/ennitant?schema=public

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# OTP
# console = log codes (local/dev). sms|whatsapp require OTP_API_KEY + provider adapter.
OTP_PROVIDER=console
OTP_API_KEY=
# set true in local/dev to return codes in API responses + log them
OTP_DEV_MODE=true

# Token encryption (32-byte hex recommended). Required in production — never use JWT fallback there.
ENCRYPTION_KEY=

# API
API_PORT=3001
API_PREFIX=api
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# n8n (internal automation — never expose to frontend)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_SECRET=change-me-n8n-webhook-secret
N8N_ORDER_WEBHOOK_PATH=/webhook/ennitant-order
N8N_TIMEOUT_MS=15000
N8N_MAX_RETRIES=2

# Meta WhatsApp Cloud API + Embedded Signup
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=change-me-meta-verify-token
META_GRAPH_API_VERSION=v21.0
META_EMBEDDED_SIGNUP_CONFIG_ID=

# Dev-only: attach shared platform WhatsApp credentials during onboarding (NEVER in production)
WHATSAPP_PLATFORM_FALLBACK=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Email (password reset / verification — optional in local dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ennitant.com

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
